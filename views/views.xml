<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <!-- ============================================== -->
        <!-- 1. ESTATE PROPERTY VIEWS                       -->
        <!-- ============================================== -->

        <!-- Kanban View -->
        <record id="estate_property_view_kanban" model="ir.ui.view">
            <field name="name">estate.property.kanban</field>
            <field name="model">estate.property</field>
            <field name="arch" type="xml">
                <kanban default_group_by="property_type_id" records_draggable="false">
                    <field name="state"/>
                    <templates>
                        <t t-name="kanban-box">
                            <div class="oe_kanban_global_click">
                                <div class="oe_kanban_details">
                                    <strong class="o_kanban_record_title fs-5">
                                        <field name="name"/>
                                    </strong>
                                    <div class="mt-1 text-muted">
                                        Harga Harapan: <field name="expected_price"/>
                                    </div>
                                    <div t-if="record.state.raw_value == 'offer_received'" class="text-primary">
                                        Tawaran Terbaik: <field name="best_price"/>
                                    </div>
                                    <div t-if="record.selling_price.raw_value" class="text-success fw-bold">
                                        Harga Terjual: <field name="selling_price"/>
                                    </div>
                                    <div class="mt-2">
                                        <field name="tag_ids" widget="many2many_tags" options="{'color_field': 'color'}"/>
                                    </div>
                                </div>
                            </div>
                        </t>
                    </templates>
                </kanban>
            </field>
        </record>

        <!-- Tree / List View -->
        <record id="estate_property_view_tree" model="ir.ui.view">
            <field name="name">estate.property.tree</field>
            <field name="model">estate.property</field>
            <field name="arch" type="xml">
                <tree string="Properties">
                    <field name="name"/>
                    <field name="property_type_id"/>
                    <field name="tag_ids" widget="many2many_tags" options="{'color_field': 'color'}"/>
                    <field name="postcode"/>
                    <field name="bedrooms"/>
                    <field name="living_area"/>
                    <field name="expected_price"/>
                    <field name="selling_price"/>
                    <field name="date_availability"/>
                    <field name="state" widget="badge" 
                           decoration-success="state in ('offer_accepted', 'sold')"
                           decoration-danger="state == 'canceled'"
                           decoration-info="state == 'offer_received'"/>
                </tree>
            </field>
        </record>

        <!-- Form View -->
        <record id="estate_property_view_form" model="ir.ui.view">
            <field name="name">estate.property.form</field>
            <field name="model">estate.property</field>
            <field name="arch" type="xml">
                <form string="Property">
                    <header>
                        <button name="%(real_estate.action_property_offer_wizard)d" type="action" 
                                string="Ajukan Penawaran (Wizard)" class="btn-info" 
                                invisible="state in ('sold', 'canceled')"/>
                        <button name="action_set_sold" type="object" string="Tandai Terjual" 
                                class="btn-primary" invisible="state in ('sold', 'canceled')"/>
                        <button name="action_create_invoice" type="object" string="Buat Faktur (Invoice)" 
                                class="btn-success" invisible="state != 'sold' or invoice_id"/>
                        <button name="action_set_canceled" type="object" string="Batalkan" 
                                invisible="state in ('sold', 'canceled')"/>
                        <button name="action_reset" type="object" string="Kembalikan ke Belum Terjual" 
                                class="btn-secondary" invisible="state not in ('sold', 'canceled')"/>
                        <field name="state" widget="statusbar" 
                               statusbar_visible="new,offer_received,offer_accepted,sold"/>
                    </header>
                    <sheet>
                        <div class="oe_button_box" name="button_box">
                            <button name="action_view_invoice" type="object" class="oe_stat_button" 
                                    icon="fa-pencil-square-o" invisible="not invoice_id">
                                <div class="o_stat_info">
                                    <span class="o_stat_text">Faktur Tagihan</span>
                                </div>
                            </button>
                        </div>
                        <div class="oe_title">
                            <h1>
                                <field name="name" placeholder="Contoh: Villa Mewah di Jimbaran"/>
                            </h1>
                            <field name="tag_ids" widget="many2many_tags" 
                                   options="{'color_field': 'color'}" placeholder="Tambahkan Tag..."/>
                        </div>
                        <group>
                            <group>
                                <field name="property_type_id" options="{'no_create': True}"/>
                                <field name="postcode"/>
                                <field name="date_availability"/>
                            </group>
                            <group>
                                <field name="expected_price"/>
                                <field name="best_price"/>
                                <field name="selling_price"/>
                            </group>
                        </group>
                        <notebook>
                            <page string="Deskripsi &amp; Detail">
                                <group>
                                    <group string="Spesifikasi Bangunan">
                                        <field name="description"/>
                                        <field name="bedrooms"/>
                                        <field name="living_area"/>
                                        <field name="facades"/>
                                        <field name="garage"/>
                                    </group>
                                    <group string="Area Luar / Taman">
                                        <field name="garden"/>
                                        <field name="garden_area" invisible="not garden"/>
                                        <field name="garden_orientation" invisible="not garden"/>
                                        <field name="total_area"/>
                                    </group>
                                </group>
                            </page>
                            <page string="Penawaran Masuk (Offers)">
                                <field name="offer_ids">
                                    <tree editable="bottom" decoration-success="status == 'accepted'" decoration-danger="status == 'refused'">
                                        <field name="price"/>
                                        <field name="partner_id"/>
                                        <button name="action_accept" type="object" icon="fa-check" 
                                                title="Terima Tawaran" invisible="status"/>
                                        <button name="action_refuse" type="object" icon="fa-times" 
                                                title="Tolak Tawaran" invisible="status"/>
                                        <field name="status"/>
                                    </tree>
                                </field>
                            </page>
                            <page string="Info Lainnya">
                                <group>
                                    <field name="salesperson_id"/>
                                    <field name="buyer_id"/>
                                    <field name="invoice_id" invisible="not invoice_id"/>
                                </group>
                            </page>
                        </notebook>
                    </sheet>
                    <!-- Chatter (Discussions, History Tracking & Activity) -->
                    <div class="oe_chatter">
                        <field name="message_follower_ids"/>
                        <field name="activity_ids"/>
                        <field name="message_ids"/>
                    </div>
                </form>
            </field>
        </record>

        <!-- Search View -->
        <record id="estate_property_view_search" model="ir.ui.view">
            <field name="name">estate.property.search</field>
            <field name="model">estate.property</field>
            <field name="arch" type="xml">
                <search string="Search Properties">
                    <field name="name"/>
                    <field name="property_type_id"/>
                    <field name="postcode"/>
                    <field name="expected_price"/>
                    <field name="bedrooms"/>
                    <field name="living_area"/>
                    <filter string="Tersedia" name="available" 
                            domain="[('state', 'in', ('new', 'offer_received'))]"/>
                    <group expand="0" string="Group By">
                        <filter string="Tipe Properti" name="group_by_type" context="{'group_by': 'property_type_id'}"/>
                        <filter string="Kodepos" name="group_by_postcode" context="{'group_by': 'postcode'}"/>
                    </group>
                </search>
            </field>
        </record>

        <!-- Window Action for Properties -->
        <record id="estate_property_action" model="ir.actions.act_window">
            <field name="name">Properties</field>
            <field name="res_model">estate.property</field>
            <field name="view_mode">kanban,tree,form</field>
            <field name="context">{'search_default_available': 1}</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Belum ada properti. Buat properti pertama Anda sekarang!
                </p>
            </field>
        </record>


        <!-- ============================================== -->
        <!-- 2. PROPERTY TYPE VIEWS                         -->
        <!-- ============================================== -->

        <record id="estate_property_type_view_tree" model="ir.ui.view">
            <field name="name">estate.property.type.tree</field>
            <field name="model">estate.property.type</field>
            <field name="arch" type="xml">
                <tree string="Property Types">
                    <field name="sequence" widget="handle"/>
                    <field name="name"/>
                    <field name="property_count"/>
                </tree>
            </field>
        </record>

        <record id="estate_property_type_view_form" model="ir.ui.view">
            <field name="name">estate.property.type.form</field>
            <field name="model">estate.property.type</field>
            <field name="arch" type="xml">
                <form string="Property Type">
                    <sheet>
                        <div class="oe_title">
                            <label for="name" string="Nama Tipe"/>
                            <h1><field name="name"/></h1>
                        </div>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="estate_property_type_action" model="ir.actions.act_window">
            <field name="name">Property Types</field>
            <field name="res_model">estate.property.type</field>
            <field name="view_mode">tree,form</field>
        </record>


        <!-- ============================================== -->
        <!-- 3. PROPERTY TAG VIEWS                          -->
        <!-- ============================================== -->

        <record id="estate_property_tag_view_tree" model="ir.ui.view">
            <field name="name">estate.property.tag.tree</field>
            <field name="model">estate.property.tag</field>
            <field name="arch" type="xml">
                <tree string="Property Tags" editable="bottom">
                    <field name="name"/>
                    <field name="color" widget="color_picker"/>
                </tree>
            </field>
        </record>

        <record id="estate_property_tag_action" model="ir.actions.act_window">
            <field name="name">Property Tags</field>
            <field name="res_model">estate.property.tag</field>
            <field name="view_mode">tree,form</field>
        </record>


        <!-- ============================================== -->
        <!-- 4. MENUS                                       -->
        <!-- ============================================== -->

        <menuitem id="estate_menu_root" name="Real Estate" sequence="10"/>

        <!-- Menu Iklan Properti -->
        <menuitem id="estate_first_level_menu" name="Advertisements" parent="estate_menu_root" sequence="10"/>
        <menuitem id="estate_property_menu_action" name="Properties" 
                  parent="estate_first_level_menu" action="estate_property_action" sequence="10"/>

        <!-- Menu Pengaturan (Configuration) -->
        <menuitem id="estate_configuration_menu" name="Configuration" parent="estate_menu_root" sequence="20"/>
        <menuitem id="estate_property_type_menu_action" name="Property Types" 
                  parent="estate_configuration_menu" action="estate_property_type_action" sequence="10"/>
        <menuitem id="estate_property_tag_menu_action" name="Property Tags" 
                  parent="estate_configuration_menu" action="estate_property_tag_action" sequence="20"/>

    </data>
</odoo>
