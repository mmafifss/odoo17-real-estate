<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">

        <!-- ============================================== -->
        <!-- 1. TIPE PROPERTI                               -->
        <!-- ============================================== -->
        <record id="type_villa" model="estate.property.type">
            <field name="name">Villa Mewah</field>
            <field name="sequence">1</field>
        </record>

        <record id="type_apartment" model="estate.property.type">
            <field name="name">Apartemen &amp; Penthouse</field>
            <field name="sequence">2</field>
        </record>

        <record id="type_house" model="estate.property.type">
            <field name="name">Rumah Residensial</field>
            <field name="sequence">3</field>
        </record>

        <record id="type_commercial" model="estate.property.type">
            <field name="name">Ruko &amp; Komersial</field>
            <field name="sequence">4</field>
        </record>

        <!-- ============================================== -->
        <!-- 2. TAGS PROPERTI                               -->
        <!-- ============================================== -->
        <record id="tag_pool" model="estate.property.tag">
            <field name="name">Private Pool</field>
            <field name="color">1</field>
        </record>

        <record id="tag_view" model="estate.property.tag">
            <field name="name">Ocean View</field>
            <field name="color">4</field>
        </record>

        <record id="tag_hook" model="estate.property.tag">
            <field name="name">Posisi Hook</field>
            <field name="color">2</field>
        </record>

        <record id="tag_furnished" model="estate.property.tag">
            <field name="name">Fully Furnished</field>
            <field name="color">5</field>
        </record>

        <record id="tag_smart" model="estate.property.tag">
            <field name="name">Smart Home</field>
            <field name="color">9</field>
        </record>

        <record id="tag_tol" model="estate.property.tag">
            <field name="name">Dekat Akses Tol</field>
            <field name="color">7</field>
        </record>

        <!-- ============================================== -->
        <!-- 3. KONTAK / CALON PEMBELI (res.partner)        -->
        <!-- ============================================== -->
        <record id="partner_budi" model="res.partner">
            <field name="name">Budi Santoso</field>
            <field name="email">budi.santoso@example.com</field>
            <field name="phone">081234567890</field>
            <field name="city">Jakarta Selatan</field>
        </record>

        <record id="partner_citra" model="res.partner">
            <field name="name">Citra Lestari</field>
            <field name="email">citra.lestari@example.com</field>
            <field name="phone">081298765432</field>
            <field name="city">Surabaya</field>
        </record>

        <record id="partner_hendra" model="res.partner">
            <field name="name">Hendra Wijaya</field>
            <field name="email">hendra.wijaya@example.com</field>
            <field name="phone">081345678901</field>
            <field name="city">Bandung</field>
        </record>

        <record id="partner_maya" model="res.partner">
            <field name="name">Maya Anggraini</field>
            <field name="email">maya.anggraini@example.com</field>
            <field name="phone">081123456789</field>
            <field name="city">Tangerang Selatan</field>
        </record>

        <!-- ============================================== -->
        <!-- 4. DATA PROPERTI (estate.property)             -->
        <!-- ============================================== -->

        <!-- Properti 1: Villa Canggu (Offer Accepted) -->
        <record id="property_villa_canggu" model="estate.property">
            <field name="name">Villa Ombak Biru - Canggu Bali</field>
            <field name="property_type_id" ref="type_villa"/>
            <field name="tag_ids" eval="[(6, 0, [ref('tag_pool'), ref('tag_view'), ref('tag_furnished')])]"/>
            <field name="description">Villa tropis modern 4 kamar tidur dengan pemandangan langsung matahari terbenam Pantai Canggu. Dilengkapi kolam renang infinity pool dan gazebo santai.</field>
            <field name="postcode">80361</field>
            <field name="expected_price">7500000000</field>
            <field name="selling_price">7200000000</field>
            <field name="bedrooms">4</field>
            <field name="living_area">350</field>
            <field name="facades">4</field>
            <field name="garage">True</field>
            <field name="garden">True</field>
            <field name="garden_area">120</field>
            <field name="garden_orientation">south</field>
            <field name="state">offer_accepted</field>
            <field name="buyer_id" ref="partner_budi"/>
        </record>

        <!-- Properti 2: Apartemen Sudirman (Offer Received) -->
        <record id="property_sudirman_suites" model="estate.property">
            <field name="name">Penthouse Sudirman Suites 35th Fl</field>
            <field name="property_type_id" ref="type_apartment"/>
            <field name="tag_ids" eval="[(6, 0, [ref('tag_smart'), ref('tag_furnished')])]"/>
            <field name="description">Unit penthouse eksklusif lantai 35 dengan pemandangan skyline Jakarta 360 derajat. Akses private lift dan sistem kontrol smart home otomatis.</field>
            <field name="postcode">10220</field>
            <field name="expected_price">5800000000</field>
            <field name="bedrooms">3</field>
            <field name="living_area">210</field>
            <field name="facades">2</field>
            <field name="garage">True</field>
            <field name="garden">False</field>
            <field name="state">offer_received</field>
        </record>

        <!-- Properti 3: Rumah Modern BSD (New) -->
        <record id="property_bsd_modern" model="estate.property">
            <field name="name">Rumah Scandinavian BSD Nava Park</field>
            <field name="property_type_id" ref="type_house"/>
            <field name="tag_ids" eval="[(6, 0, [ref('tag_hook'), ref('tag_tol'), ref('tag_smart')])]"/>
            <field name="description">Rumah idaman keluarga bergaya arsitektur Skandinavia minimalis. Lokasi hook yang asri, pencahayaan alami maksimal, dan 5 menit ke gerbang tol.</field>
            <field name="postcode">15345</field>
            <field name="expected_price">3250000000</field>
            <field name="bedrooms">3</field>
            <field name="living_area">165</field>
            <field name="facades">2</field>
            <field name="garage">True</field>
            <field name="garden">True</field>
            <field name="garden_area">45</field>
            <field name="garden_orientation">east</field>
            <field name="state">new</field>
        </record>

        <!-- Properti 4: Ruko Komersial Serpong (New) -->
        <record id="property_ruko_serpong" model="estate.property">
            <field name="name">Ruko Komersil 3 Lantai Gading Serpong</field>
            <field name="property_type_id" ref="type_commercial"/>
            <field name="tag_ids" eval="[(6, 0, [ref('tag_hook'), ref('tag_tol')])]"/>
            <field name="description">Unit ruko komersial di jalur boulevard utama dengan lalu lintas padat. Sangat ideal untuk kantor cabang bank, cafe, atau klinik kecantikan.</field>
            <field name="postcode">15810</field>
            <field name="expected_price">4100000000</field>
            <field name="bedrooms">1</field>
            <field name="living_area">240</field>
            <field name="facades">1</field>
            <field name="garage">True</field>
            <field name="garden">False</field>
            <field name="state">new</field>
        </record>

        <!-- Properti 5: Townhouse Senopati (Sold) -->
        <record id="property_senopati_townhouse" model="estate.property">
            <field name="name">Luxury Townhouse Senopati Kebayoran</field>
            <field name="property_type_id" ref="type_house"/>
            <field name="tag_ids" eval="[(6, 0, [ref('tag_pool'), ref('tag_smart'), ref('tag_furnished')])]"/>
            <field name="description">Townhouse prestisius di pusat kuliner Senopati. Desain modern klasik dengan kolam renang pribadi di rooftop dan garasi muat 3 mobil.</field>
            <field name="postcode">12190</field>
            <field name="expected_price">12500000000</field>
            <field name="selling_price">12000000000</field>
            <field name="bedrooms">5</field>
            <field name="living_area">480</field>
            <field name="facades">3</field>
            <field name="garage">True</field>
            <field name="garden">True</field>
            <field name="garden_area">80</field>
            <field name="garden_orientation">north</field>
            <field name="state">sold</field>
            <field name="buyer_id" ref="partner_maya"/>
        </record>

        <!-- ============================================== -->
        <!-- 5. PENAWARAN (estate.property.offer)           -->
        <!-- ============================================== -->

        <!-- Penawaran untuk Villa Canggu -->
        <record id="offer_villa_hendra" model="estate.property.offer">
            <field name="property_id" ref="property_villa_canggu"/>
            <field name="partner_id" ref="partner_hendra"/>
            <field name="price">6800000000</field>
            <field name="status">refused</field>
        </record>

        <record id="offer_villa_budi" model="estate.property.offer">
            <field name="property_id" ref="property_villa_canggu"/>
            <field name="partner_id" ref="partner_budi"/>
            <field name="price">7200000000</field>
            <field name="status">accepted</field>
        </record>

        <!-- Penawaran untuk Apartemen Sudirman -->
        <record id="offer_sudirman_citra" model="estate.property.offer">
            <field name="property_id" ref="property_sudirman_suites"/>
            <field name="partner_id" ref="partner_citra"/>
            <field name="price">5500000000</field>
        </record>

        <record id="offer_sudirman_maya" model="estate.property.offer">
            <field name="property_id" ref="property_sudirman_suites"/>
            <field name="partner_id" ref="partner_maya"/>
            <field name="price">5650000000</field>
        </record>

    </data>
</odoo>

